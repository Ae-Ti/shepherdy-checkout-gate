{
  "name": "shepherdy-checkout-gate",
  "version": "0.1.0",
  "private": true,
  "description": "A release gate for AI-written PayPal checkouts: it attacks the checkout in the PayPal sandbox and says READY only when PayPal's own records agree.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "typecheck": "tsc --noEmit",
    "gate": "node gate/run.mjs",
    "gate:static": "node gate/run.mjs --static-only",
    "loop": "node agent/loop.mjs",
    "test": "LLM_MODE=fake node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@paypal/react-paypal-js": "^10.6.1",
    "next": "^16.4.6",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.9"
  }
}
