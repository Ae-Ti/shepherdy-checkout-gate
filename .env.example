# Copy to .env.local and fill in your PayPal SANDBOX app credentials (developer.paypal.com > Apps & Credentials > Sandbox).
# Never commit .env.local. The gate checks for that (S3).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox only. The gate refuses to run against live PayPal (PP-08).
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Booking storage. Leave empty for a local file store (.data/bookings.json).
# Required on serverless hosts such as Vercel: any Postgres URL (Neon, Supabase pooler, ...).
DATABASE_URL=
# DATABASE_SSL=disable   # only for a local Postgres without TLS

# Gate: PayPal sandbox PERSONAL (buyer) account for the end-to-end payment check (E1).
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
# Gate: any long random string. Lets the gate ask the app to simulate a declined payment (A6). Sandbox only.
GATE_MOCK_TOKEN=

# Fix loop (agent/loop.mjs). LLM_MODE=fake restores the last READY version of the flagged files without AI.
LLM_MODE=live
ANTHROPIC_API_KEY=
SHEPHERDY_MODEL=claude-sonnet-5-5
# AGENT_CMD=   # optional: any coding agent command; it receives the brief path in $FIX_BRIEF
